# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB Connection String (Atlas or local MongoDB)
MONGODB_URI="mongodb://127.0.0.1:27017/foodapp_db"

# Admin Authentication
JWT_ACCESS_SECRET="your_super_secret_jwt_access_token_key_change_in_production_min_32_chars"
JWT_EXPIRES_IN="7d"

# Security & CORS
CORS_ORIGIN="http://localhost:5173"

# Delivery Configuration
DELIVERY_FEE=3.99
FREE_DELIVERY_THRESHOLD=50.00
